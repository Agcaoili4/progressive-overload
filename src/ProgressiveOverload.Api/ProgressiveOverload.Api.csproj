<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ProgressiveOverload.Infrastructure\ProgressiveOverload.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dev-tooling only: the EF Core CLI requires Microsoft.EntityFrameworkCore.Design to be
      present in the startup project, even though AppDbContext lives in Application (which
      already references Design with PrivateAssets="all"). PrivateAssets="all" here means it
      does not become a runtime dependency and does not leak to anything referencing Api.
    -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>170a0be4-e5db-4a54-8a8a-c61d8ac81d4f</UserSecretsId>
  </PropertyGroup>

</Project>
