<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProgressiveOverload.Application\ProgressiveOverload.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Infrastructure is a plain (non-Web) SDK project but needs IHttpContextAccessor/HttpContext
      for CurrentUser. FrameworkReference pulls in the ASP.NET Core shared framework without
      switching this project to Microsoft.NET.Sdk.Web.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Extensions.Identity.Core is not referenced directly here: it ships as part of
      the ASP.NET Core shared framework (pulled in by the FrameworkReference above), and NuGet's
      package-pruning feature (NU1510, an error under TreatWarningsAsErrors) rejects an explicit
      PackageReference that duplicates it.
    -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
